# Neon PostgreSQL connection string (do not commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication (generate a strong random secret for production)
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment: development | production
ENVIRONMENT=development

# Optional: Groq API key for LLM-powered AI Assistant responses
# GROQ_API_KEY=
